# Go standard .gitignore

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work

# Build artifacts
bin/
dist/
/airgapctl

# E2E compiled binary
tests/e2e/airgapctl

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store

# Git worktrees
.worktrees/

# Demo generated artifacts
demo/*.gif
!demo/airgapctl-demo.gif
demo/fixtures/*.airgap

# Demo temp binaries
demo/airgapctl
demo/generate-bundle
