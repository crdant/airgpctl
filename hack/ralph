#!/usr/bin/env bash
set -euo pipefail

ITERATIONS="${1:-10}"

for i in $(seq 1 "$ITERATIONS"); do
  result=$(opencode run "
You are continuing a feature implementation.

Inputs:
- PRD: @docs/brainstorms/2026-05-14-airgapctl-requirements.md
- Progress: @docs/progress.md
- Repo notes: @AGENTS.md

Rules:
1. Pick the single highest-priority unfinished task.
2. Use the ce-work skill to implement it test first using true RED-GREEN-REFACTOR on a per test basis
3. Commit your work.
4. Use the ce-code-review skill and LFG the results.
5. Commit your work.
3. Capture what you learned with the ce-compound skill and write all the documents suggested.
4. Update progress.md with what changed.
6. Commit the work.
7. If everything is done, output <promise>COMPLETE</promise>.
")

  echo "$result"

  if [[ "$result" == *"<promise>COMPLETE</promise>"* ]]; then
    echo "Done."
    break
  fi
done
