#!/usr/bin/env bash
set -euo pipefail

DOC=${1}
ITERATIONS="${2:-10}"

for i in $(seq 1 "$ITERATIONS"); do
  echo "🚀 Starting iteration $i / $ITERATIONS"

  if ! result=$(opencode run "
You are continuing a feature implementation.

Inputs:
- PRD: @${DOC}
- Progress: @docs/progress.md
- Repo notes: @AGENTS.md

Rules:
1. Pick the next unfinished unit.
2. Dispatch a subagent to run /ce-work @docs/${DOC} to implement that unit test first one RED-GREEN-REFACTOR at at time
3. Wait for that agent to finish and commit your work.
4. Dispatch a subagent to run /ce-code-review and address all findings test-first
5. Wait for that agent to finish and commit the review fixes.
6. Dispatch another agent to /ce-compound
7. Wait for that agent to finish and update progress.md with what changed.
8. Commit the progress update.
9. If everything is done, output <promise>COMPLETE</promise>.
"); then
    echo "❌ Iteration $i failed with exit code $?"
    continue
  fi

  echo "$result"

  if [[ "$result" == *"<promise>COMPLETE</promise>"* ]]; then
    echo "✅ Done."
    break
  fi
done
