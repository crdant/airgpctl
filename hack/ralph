#!/usr/bin/env bash
set -euo pipefail

ITERATIONS="${1:-10}"

for i in $(seq 1 "$ITERATIONS"); do
  echo "🚀 Starting iteration $i / $ITERATIONS"

  if ! result=$(opencode run "
You are continuing a feature implementation.

Inputs:
- PRD: @docs/plans/2026-05-14-001-feat-cobra-cli-subcommands-plan.md
- Progress: @docs/progress.md
- Repo notes: @AGENTS.md

Rules:
1. Pick the single highest-priority unfinished task.
2. Use the ce-work skill to implement it test-first using true RED-GREEN-REFACTOR on a per test basis.
3. Commit your work.
4. Use the ce-code-review skill and LFG the results.
5. Commit the review fixes.
6. Capture what you learned with the ce-compound skill and write all the documents suggested.
7. Update progress.md with what changed.
8. Commit the progress update.
9. If everything is done, output <promise>COMPLETE</promise>.
"); then
    echo "❌ Iteration $i failed with exit code $?"
    continue
  fi

  echo "$result"

  if [[ "$result" == *"<promise>COMPLETE</promise>"* ]]; then
    echo "✅ Done."
    break
  fi
done
